{
  "name": "react-native-selectable-markdown",
  "version": "0.11.0",
  "description": "Streaming-first CommonMark + GFM markdown renderer for React Native with document-grade text selection: every rendered character maps back to an exact UTF-16 range of the source.",
  "license": "MIT",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "android",
    "platform",
    "SelectableMarkdown.podspec",
    "react-native.config.js",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/superpowerdotcom/react-native-selectable-markdown.git"
  },
  "keywords": [
    "react-native",
    "markdown",
    "commonmark",
    "gfm",
    "streaming",
    "llm",
    "selection",
    "copy"
  ],
  "author": "Superpower",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/emit-dist-spec-shim.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "verify:pack": "node scripts/verify-pack.mjs",
    "check:codegen": "node scripts/check-codegen.mjs",
    "check:fabric-cpp": "node scripts/check-fabric-cpp.mjs",
    "check:fabric-cpp:selftest": "node scripts/check-fabric-cpp.mjs --selftest",
    "check:swift": "node scripts/check-swift.mjs",
    "check:swift:selftest": "node scripts/check-swift.mjs --selftest",
    "conformance": "node conformance/run-commonmark.mjs",
    "bench:throughput": "node bench/throughput.mjs",
    "bench:pathological": "node bench/pathological.mjs",
    "bench:streaming": "node bench/streaming-replay.mjs",
    "bench:crossing": "node bench/crossing.mjs",
    "bench:all": "node bench/throughput.mjs && node bench/pathological.mjs && node bench/streaming-replay.mjs && node bench/crossing.mjs",
    "bench:headtohead": "node bench/head-to-head.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.82"
  },
  "codegenConfig": {
    "name": "SelectableMarkdownSpec",
    "type": "components",
    "jsSrcsDir": "src/view",
    "android": {
      "javaPackageName": "com.selectablemarkdown"
    },
    "ios": {
      "componentProvider": {
        "SelectableRunHost": "RCTSelectableRunHostComponentView"
      }
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.3",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.75.4",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
