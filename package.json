{
  "name": "react-native-selectable-markdown",
  "version": "0.11.0",
  "description": "Streaming-first CommonMark + GFM markdown renderer for React Native with document-grade text selection: every rendered character maps back to an exact UTF-16 range of the source.",
  "license": "MIT",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": "./dist/index.js"
    },
    "./dist": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": "./dist/index.js"
    },
    "./dist/*.js": {
      "require": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "import": {
        "types": "./dist/esm/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "default": "./dist/*.js"
    },
    "./dist/*": {
      "require": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "import": {
        "types": "./dist/esm/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "default": "./dist/*.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./react-native.config.js": "./react-native.config.js",
    "./node": "./native/node/index.mjs",
    "./engine": {
      "react-native": "./src/engine.ts",
      "require": {
        "types": "./dist/engine.d.ts",
        "default": "./dist/engine.js"
      },
      "import": {
        "types": "./dist/esm/engine.d.ts",
        "default": "./dist/esm/engine.js"
      },
      "default": "./dist/engine.js"
    },
    "./stream": {
      "react-native": "./src/stream.ts",
      "require": {
        "types": "./dist/stream.d.ts",
        "default": "./dist/stream.js"
      },
      "import": {
        "types": "./dist/esm/stream.d.ts",
        "default": "./dist/esm/stream.js"
      },
      "default": "./dist/stream.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "android",
    "platform",
    "!**/*.o",
    "!**/*.a",
    "SelectableMarkdown.podspec",
    "react-native.config.js",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "native/node",
    "scripts/build-node-addon.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/superpowerdotcom/react-native-selectable-markdown.git"
  },
  "keywords": [
    "react-native",
    "markdown",
    "commonmark",
    "gfm",
    "streaming",
    "llm",
    "selection",
    "copy"
  ],
  "author": "Superpower",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/finish-esm-build.mjs && node scripts/emit-dist-spec-shim.mjs",
    "build:watch": "node scripts/emit-dist-spec-shim.mjs && tsc -p tsconfig.build.json --watch",
    "release": "node scripts/release.mjs",
    "prepare": "npm run build",
    "verify:pack": "node scripts/verify-pack.mjs",
    "check:codegen": "node scripts/check-codegen.mjs",
    "check:fabric-cpp": "node scripts/check-fabric-cpp.mjs",
    "check:fabric-cpp:selftest": "node scripts/check-fabric-cpp.mjs --selftest",
    "check:swift": "node scripts/check-swift.mjs",
    "check:swift:selftest": "node scripts/check-swift.mjs --selftest",
    "conformance": "node conformance/run-commonmark.mjs",
    "bench:throughput": "node bench/throughput.mjs",
    "bench:pathological": "node bench/pathological.mjs",
    "bench:streaming": "node bench/streaming-replay.mjs",
    "bench:crossing": "node bench/crossing.mjs",
    "bench:projection": "node bench/projection.mjs",
    "bench:all": "node bench/throughput.mjs && node bench/pathological.mjs && node bench/streaming-replay.mjs && node bench/crossing.mjs && node bench/projection.mjs",
    "bench:headtohead": "node bench/head-to-head.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.82"
  },
  "codegenConfig": {
    "name": "SelectableMarkdownSpec",
    "type": "components",
    "jsSrcsDir": "src/view",
    "android": {
      "javaPackageName": "com.selectablemarkdown"
    },
    "ios": {
      "componentProvider": {
        "SelectableRunHost": "RCTSelectableRunHostComponentView"
      }
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.3",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.75.4",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
