  "repository": {
    "type": "git",
    "url": "https://github.com/superpowerdotcom/react-native-selectable-markdown.git"
  },
  "keywords": [
    "react-native",
    "markdown",
    "commonmark",
    "gfm",
    "streaming",
    "llm",
    "selection",
    "copy"
  ],
  "author": "Superpower",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/finish-esm-build.mjs && node scripts/emit-dist-spec-shim.mjs",
    "build:watch": "node scripts/emit-dist-spec-shim.mjs && tsc -p tsconfig.build.json --watch",
    "release": "node scripts/release.mjs",
    "prepare": "npm run build",
    "verify:pack": "node scripts/verify-pack.mjs",
    "check:codegen": "node scripts/check-codegen.mjs",
    "check:fabric-cpp": "node scripts/check-fabric-cpp.mjs",
    "check:fabric-cpp:selftest": "node scripts/check-fabric-cpp.mjs --selftest",
    "check:swift": "node scripts/check-swift.mjs",
    "check:swift:selftest": "node scripts/check-swift.mjs --selftest",
    "conformance": "node conformance/run-commonmark.mjs",
    "bench:throughput": "node bench/throughput.mjs",
    "bench:pathological": "node bench/pathological.mjs",
    "bench:streaming": "node bench/streaming-replay.mjs",
    "bench:crossing": "node bench/crossing.mjs",
    "bench:projection": "node bench/projection.mjs",
    "bench:all": "node bench/throughput.mjs && node bench/pathological.mjs && node bench/streaming-replay.mjs && node bench/crossing.mjs && node bench/projection.mjs",
    "bench:headtohead": "node bench/head-to-head.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.82"
  },
  "codegenConfig": {
    "name": "SelectableMarkdownSpec",
    "type": "components",
    "jsSrcsDir": "src/view",
    "android": {
      "javaPackageName": "com.selectablemarkdown"
    },
    "ios": {
      "componentProvider": {
        "SelectableRunHost": "RCTSelectableRunHostComponentView"
      }
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.82.1",
    "@types/jest": "^29.5.12",
    "@types/react": "19.1.1",
    "jest": "^29.7.0",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0",
    "react-test-renderer": "19.1.1",
    "@types/react-test-renderer": "19.1.0"
