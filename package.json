    "!src/**/__tests__",
    "android",
    "platform",
    "!**/*.o",
    "!**/*.a",
    "!android/build",
    "!android/.cxx",
    "!android/.gradle",
    "!**/*.so",
    "!**/*.dylib",
    "!**/*.node",
    "!**/*.obj",
    "!**/*.lib",
